# J-Quants (日本株の業績予想取得。既存のScreening Tool core/providers/jquants.py が
# J-Quants API V1のリフレッシュトークン方式で使用する)
# 取得方法: https://jpx-jquants.com/ でサインアップし、
# リフレッシュトークンを取得してここに貼り付ける(READMEの手順を参照)。
JQUANTS_REFRESH_TOKEN=

# J-Quants API V2 (Japanese_Equity_Lab/ の日次株価Pipelineで使用、上のJQUANTS_REFRESH_TOKENとは別物)
# J-Quants API V2はAPI Key方式(x-api-key Header)。契約者ダッシュボードでAPIキーを
# 取得してここに貼り付ける(Japanese_Equity_Lab/LOCAL_DATA_FETCH_GUIDE.md参照)。
JQUANTS_API_KEY=

# Finnhub (米国株の業績予想取得に使用)
# 取得方法: https://finnhub.io/ でサインアップし、APIキーを取得してここに貼り付ける。
FINNHUB_API_KEY=
